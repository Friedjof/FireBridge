TZ=Europe/Berlin

# TZ is also the default timezone for YAML cron schedules.

# Logging — emitted on stderr so `docker logs` and `docker compose logs -f` capture it.
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL  (default INFO)
# LOG_FORMAT: text (human-readable, optional ANSI colour) | json (one record per line)
# LOG_COLOR: auto (TTY only, default) | always | never
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_COLOR=auto

# ADB over USB: leave ADB_TARGET empty and keep the USB volume in compose.yml.
# ADB over Wi-Fi: set ADB_TARGET to the tablet address, for example 192.168.1.50:5555.
ADB_TARGET=
ADB_SERIAL=
ADB_CONNECT_ON_START=true
ADB_COMMAND_TIMEOUT=10

# MQTT broker used by Home Assistant.
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USERNAME=firebridge
MQTT_PASSWORD=change-me
MQTT_CLIENT_ID=firebridge-fire-hd8
MQTT_BASE_TOPIC=firebridge/fire-hd8
MQTT_DISCOVERY_ENABLED=true
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_STATE_INTERVAL=30
MQTT_IGNORE_RETAINED_COMMANDS=true

# On startup, scan retained discovery topics for this DEVICE_ID and remove
# any that no longer correspond to a configured endpoint (HA deletes the entity).
MQTT_DISCOVERY_CLEANUP=true
MQTT_DISCOVERY_CLEANUP_DELAY=3.0

# compose.yml mounts ./examples here, so every example YAML becomes active.
CONFIG_DIR=/config/endpoints

# Home Assistant device metadata.
DEVICE_ID=fire_hd8_wallpanel
DEVICE_NAME=Fire HD 8 Wallpanel

# Values consumed by example YAML endpoints.
UNLOCK_PIN=change-me

# Dashboard slug the prod view-selector deep-links into the HA Companion app
# (homeassistant://navigate/<HA_DASHBOARD>/<view>). Default is "lovelace".
HA_DASHBOARD=lovelace

# Keep raw ADB disabled unless a future admin endpoint explicitly needs it.
ENABLE_RAW_ADB=false
